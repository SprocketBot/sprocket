/* Write your global styles here, in PostCSS syntax */
@tailwind base;
@tailwind components;
@tailwind utilities;

html {
  width: 100%;
  max-width: 100%;
  height: 100%;
  overflow-x: hidden;
}

* {
  font-family: 'Montserrat', sans-serif;
  scrollbar-width: thin;
  scrollbar-color: theme("colors.gray.400") theme("colors.gray.900");
}

*::-webkit-scrollbar {
  width: 10px;
  height: 10px;
}

*::-webkit-scrollbar-track {
  background: theme("colors.gray.900");
}

*::-webkit-scrollbar-thumb {
  background: theme("colors.gray.500");
  border-radius: 999px;
  border: 2px solid theme("colors.gray.900");
}

*::-webkit-scrollbar-thumb:hover {
  background: theme("colors.sprocket");
}

*::-webkit-scrollbar-corner {
  background: theme("colors.gray.900");
}

body {
  @apply text-gray-100 text-opacity-80 bg-gray-800 min-h-screen overflow-x-hidden max-w-full;
}
h1,
h2,
h3,
h4,
h5,
h6 {
  @apply text-opacity-100 text-gray-100;
}

table.table tr:not(thead tr) {
  @apply bg-base-200/75;
  &:nth-child(even) {
    @apply bg-base-200/50;
  }
  &:last-child {
    td:last-child {
      @apply rounded-br-lg;
    }
    td:first-child {
      @apply rounded-bl-lg;
    }
  }
}
